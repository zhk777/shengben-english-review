PORT=8787
# PostgreSQL 连接串。生产环境必须配置；未配置时仅启用本地设备/文件兼容模式。
DATABASE_URL=postgresql://study_user:change-me@127.0.0.1:5432/shengben_review
# 本地 PostgreSQL 可设为 false；生产托管数据库建议 true，并保持证书校验开启。
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5
SESSION_DAYS=30
# 可选值：lax（推荐）、strict、none。none 必须配合 HTTPS 与 COOKIE_SECURE=true。
COOKIE_SAME_SITE=lax
# 用随机长字符串生成签名 Cookie（至少 32 字节）；不要提交真实值。
COOKIE_SECRET=replace-with-a-long-random-secret
# 临时使用 HTTP+IP 测试时设为 false；启用 HTTPS 后必须改为 true。
COOKIE_SECURE=true
TRUST_PROXY=1
# 生产部署时填写你的前端域名；多个域名用英文逗号分隔。
ALLOWED_ORIGINS=https://study.example.com
# 数据文件建议挂载到服务器持久化磁盘或 Docker volume。
DATA_DIR=./data

# 千问：仅保存在服务器环境变量，绝不能填写到 VITE_* 文件或前端代码。
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
# 可使用阿里云百炼提供的工作空间专属 OpenAI 兼容地址。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 数据库备份脚本使用；目录应位于服务器持久化磁盘。
BACKUP_DIR=./backups
