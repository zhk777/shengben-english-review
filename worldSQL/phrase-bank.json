  "learningModule": {
    "position": "早间学习 > 当天新知识 > 单词学习之后、语法学习之前",
    "newPhraseCount": 5,
    "estimatedMinutes": 20,
    "morningFlow": [
      "逐张展示短语、中文、结构提示、例句与英式/美式发音按钮",
      "作文类短语进行一次拼写或补全；识别类短语进行英译中口头回答",
      "完成 5 张卡后，进行 5 题即时辨认或易混搭配小测"
    ],
    "eveningFlow": [
      "复习当天 5 个短语",
      "抽取前 1、3、7 天的到期短语与错短语",
      "作文优先短语要求英译汉、汉译英；阅读识别短语以英译汉为主"
    ],
    "progressBinding": "完成 5 张新短语卡并交即时小测后，早间“短语搭配”任务记为完成；晚间复习完成后更新总进度与短语正确率。",
    "wrongBookRule": "小测错误或两次回忆失败的短语进入短语错题集；下次练习优先按错误次数、到期时间和最近错误时间加权抽取。"
  },
